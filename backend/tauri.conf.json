{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DBForge",
  "mainBinaryName": "DBForge",
  "version": "0.3.1",
  "identifier": "dev.dbforge.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "DBForge",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3NEREMDU1NTRDODQ5RTEKUldUaFNjaFVWZEJOSnhjVTU2N2s0NUFza29CR25OelZ3WTlHTGNOYmZ6RTBpczZJOGNiK0JybnQK",
      "endpoints": [
        "https://github.com/Juan-Motta/dbforge/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
